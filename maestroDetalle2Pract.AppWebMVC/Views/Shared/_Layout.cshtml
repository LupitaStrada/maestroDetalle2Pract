<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Aplicación</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/feminine.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>
<body class="bg-floral-white">
    <header class="bg-white py-3 border-bottom shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand text-dark font-weight-bold logo-feminine" asp-area="" asp-controller="Home" asp-action="Index">Mi App</a>
            <nav>
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark px-3 hover-petal" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark px-3 hover-petal" asp-area="" asp-controller="Productoes" asp-action="Index">Productos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark px-3 hover-petal" asp-area="" asp-controller="Ventas" asp-action="Index">Ventas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-muted px-3" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>
    <div class="container py-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-4 mt-5 bg-floral-white border-top text-center text-muted small">
        <div class="container">
            &copy; 2025 - Mi Aplicación 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>